{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Splashed Ink session v1",
  "description": "A recorded painting session. Replaying the events at their ticks reproduces the picture. See docs/DATA_FORMAT.md.",
  "type": "object",
  "required": [
    "format",
    "id",
    "app",
    "startedAt",
    "tickRate",
    "stepsPerTick",
    "seed",
    "paperSeed",
    "device",
    "settings",
    "endTick",
    "events"
  ],
  "properties": {
    "format": {
      "const": "splashed-ink-session/v1"
    },
    "id": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "startedAt": {
      "type": "string"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "tickRate": {
      "const": 60
    },
    "stepsPerTick": {
      "const": 6
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Seeds the random stream used for brush jitter."
    },
    "paperSeed": {
      "type": "integer",
      "minimum": 0,
      "description": "Seeds the paper's fibres and permeability."
    },
    "device": {
      "type": "object",
      "required": [
        "viewport",
        "sim"
      ],
      "properties": {
        "viewport": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "dpr": {
          "type": "number"
        },
        "sim": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Simulation grid size [width, height]. Replays use it, not the replaying device's own size."
        },
        "touch": {
          "type": "boolean"
        },
        "tiltSensor": {
          "type": "boolean"
        },
        "lockedSettings": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "endTick": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": [
        "object",
        "null"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "required": [
        "undo",
        "drying",
        "ink",
        "words",
        "sees",
        "redo"
      ],
      "properties": {
        "undo": {
          "enum": [
            "none",
            "one",
            "unlimited"
          ]
        },
        "drying": {
          "enum": [
            "slow",
            "normal",
            "fast",
            "instant"
          ]
        },
        "ink": {
          "enum": [
            "scarce",
            "normal",
            "unlimited"
          ]
        },
        "words": {
          "enum": [
            "off",
            "on"
          ]
        },
        "sees": {
          "enum": [
            "paper",
            "paper+strokes"
          ]
        },
        "redo": {
          "enum": [
            "final",
            "redo"
          ]
        },
        "roles": {
          "enum": [
            "you-splash",
            "partner-splash",
            "free"
          ],
          "description": "Who does what. Absent in sessions from before version 0.5, which behave as 'free'."
        },
        "hints": {
          "enum": [
            "off",
            "ladder",
            "whole"
          ],
          "description": "Charcoal hints from the Look tool: none, a little at a time (the default), or a whole reading at once. Absent in sessions from before version 0.6."
        }
      }
    },
    "gesture": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "x",
            "y",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "pour"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "seconds": {
              "type": "number"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "ink": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "path",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "stroke"
            },
            "path": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "seconds": {
              "type": "number"
            },
            "ink": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "dx",
            "dy",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "tilt"
            },
            "dx": {
              "type": "number"
            },
            "dy": {
              "type": "number"
            },
            "seconds": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "wait"
            },
            "seconds": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "path",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "outline"
            },
            "path": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "seconds": {
              "type": "number"
            },
            "ink": {
              "type": "number"
            },
            "press": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1,
              "description": "How hard the fine brush is pressed at the middle of the line (it lifts toward both ends)."
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "t",
        "e"
      ],
      "properties": {
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "e": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "e": {
              "enum": [
                "pd",
                "pm"
              ]
            },
            "i": {
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "p": {
              "type": "number"
            }
          },
          "required": [
            "i",
            "x",
            "y",
            "p"
          ]
        },
        {
          "properties": {
            "e": {
              "const": "pu"
            },
            "i": {
              "type": "string"
            }
          },
          "required": [
            "i"
          ]
        },
        {
          "properties": {
            "e": {
              "const": "g"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ]
        },
        {
          "properties": {
            "e": {
              "const": "k"
            },
            "k": {
              "enum": [
                "roles",
                "undo",
                "drying",
                "ink",
                "words",
                "sees",
                "redo",
                "hints"
              ]
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "k",
            "v"
          ]
        },
        {
          "properties": {
            "e": {
              "const": "st"
            },
            "n": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "n"
          ]
        },
        {
          "properties": {
            "e": {
              "const": "sh"
            },
            "s": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "s"
          ]
        },
        {
          "properties": {
            "e": {
              "enum": [
                "un",
                "rd"
              ]
            }
          }
        },
        {
          "properties": {
            "e": {
              "const": "tl"
            },
            "v": {
              "enum": [
                "pour",
                "brush",
                "line",
                "look"
              ]
            }
          },
          "required": [
            "v"
          ]
        },
        {
          "properties": {
            "e": {
              "const": "pot"
            },
            "c": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "c"
          ]
        },
        {
          "properties": {
            "e": {
              "const": "pa"
            },
            "partner": {
              "type": "string"
            },
            "words": {
              "type": "string"
            },
            "sees": {
              "enum": [
                "paper",
                "paper+strokes"
              ]
            }
          },
          "required": [
            "partner"
          ]
        },
        {
          "properties": {
            "e": {
              "const": "pg"
            },
            "gestures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/gesture"
              }
            }
          },
          "required": [
            "gestures"
          ]
        },
        {
          "properties": {
            "e": {
              "const": "pe"
            },
            "code": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "e": {
              "const": "pr"
            },
            "partner": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "note": {
              "type": "string",
              "description": "What the partner reports about its turn, for the record (for example which paintings the Reader borrowed from). Never shown to the person while painting."
            }
          }
        },
        {
          "properties": {
            "e": {
              "const": "note"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "description": "A note for the record, such as the paper being exported. Does not change the paper."
        },
        {
          "properties": {
            "e": {
              "const": "ch"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "description": "A charcoal layer (a faint hint from outside, such as the charcoal notebook) was shown over the paper: the file's name, or 'again'. It fades and never changes the ink, so it is not needed to replay the paper."
        },
        {
          "properties": {
            "e": {
              "const": "cm"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 2
            }
          },
          "required": [
            "path"
          ],
          "description": "The person sketched with the Look tool: a charcoal line (x, y from 0 to 1) shown over the paper. Never ink, so not needed to replay the paper."
        },
        {
          "properties": {
            "e": {
              "const": "lk"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "rung": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "description": "0 nothing to read where the person tapped; 1 where a painter would start; 2 half the form; 3 all of it"
            },
            "mode": {
              "enum": [
                "ladder",
                "whole"
              ]
            },
            "reading": {
              "type": "integer",
              "description": "which of the candidate readings (0 = the best fit)"
            },
            "motif": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "withMarks": {
              "type": "boolean",
              "description": "the reading took the person's own charcoal into account"
            },
            "skill": {
              "type": "integer",
              "description": "outlines the person had made so far without asking for a hint; hints fade sooner as it grows"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "dots": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "ring": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dur": {
              "type": "integer",
              "description": "ticks until the hint has faded"
            },
            "alpha": {
              "type": "number"
            },
            "blot": {
              "type": "integer",
              "description": "which blot on this sheet (a new hint on the same blot replaces the last one)"
            }
          },
          "required": [
            "x",
            "y",
            "rung",
            "mode"
          ],
          "description": "The person tapped a blot with the Look tool and was shown a charcoal hint, recorded with what was drawn so a replay shows what they saw. Never ink."
        },
        {
          "properties": {
            "e": {
              "const": "li"
            },
            "hinted": {
              "type": "boolean"
            },
            "follow": {
              "type": "number",
              "description": "share of the outline that lies on hint lines shown for that blot"
            },
            "own": {
              "type": "number",
              "description": "share of the outline that lies on the person's own charcoal"
            }
          },
          "required": [
            "hinted",
            "follow",
            "own"
          ],
          "description": "After an outline on a blot: whether a hint had been asked for there, and how closely the outline follows the hints and the person's own charcoal."
        }
      ]
    }
  }
}
